<Window x:Class="Aoe4Helper.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:AduSkin="clr-namespace:AduSkin.Controls.Metro;assembly=AduSkin"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:AduAttach="clr-namespace:AduSkin.Controls.Attach;assembly=AduSkin"
      Title="WKY.Aoe4Helper" SizeToContent="WidthAndHeight" Topmost="True" ShowActivated="False" ResizeMode="NoResize" Width="285">
   <Grid HorizontalAlignment="Left" Width="285">
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition Height="130*"/>
            <RowDefinition Height="34*"/>
            <RowDefinition Height="95*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ShowControlBorder}" Effect="{x:Null}" Margin="10,10,10,10" Padding="0,0,0,0"  Background="Transparent" Grid.RowSpan="3" Grid.Row="1">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <AduSkin:AduFormLable Title="CIV" Margin="0,0,0,0" HorizontalAlignment="Left">
                        <Grid Width="90" Height="40">
                        <AduSkin:AduComboBox x:Name="CivilizationSelector" SelectionChanged="Civ_Changed" SelectedIndex="-1"
                                            Width="90" Height="40" HorizontalAlignment="Left" AduAttach:InputAttach.InputHint="">
                            <AduSkin:AduComboBox.Resources>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="Width" Value="52"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Stretch" Value="Uniform"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="UseLayoutRounding" Value="True"/>
                                </Style>
                            </AduSkin:AduComboBox.Resources>
                            <ComboBoxItem Name="abbasid_dynasty">
                                <Image Source="/Resources/Img/flags/abbasid_dynasty-b722e3e4ee862226395c692e73cd14c18bc96c3469874d2e0d918305c70f8a69.png" />
                            </ComboBoxItem>
                            <ComboBoxItem Name="holy_roman_empire">
                                <Image Source="/Resources/Img/flags/holy_roman_empire-fc0be4151234fc9ac8f83e10c83b4befe79f22f7a8f6ec1ff03745d61adddb4c.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="ayyubids" >
                                <Image Source="/Resources/Img/flags/ayyubids-9ba464806c83e293ac43e19e55dddb80f1fba7b7f5bcb6f7e53b48c4b9c83c9e.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="byzantines" >
                                <Image Source="/Resources/Img/flags/byzantines-cfe0492a2ed33b486946a92063989a9500ae54d9301178ee55ba6b4d4c7ceb84.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="chinese" >
                                <Image Source="/Resources/Img/flags/chinese-2d4edb3d7fc7ab5e1e2df43bd644aba4d63992be5a2110ba3163a4907d0f3d4e.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="delhi_sultanate" >
                                <Image Source="/Resources/Img/flags/delhi_sultanate-7f92025d0623b8e224533d9f28b9cd7c51a5ff416ef3edaf7cc3e948ee290708.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="english">
                                <Image Source="/Resources/Img/flags/english-8c6c905d0eb11d6d314b9810b2a0b9c09eec69afb38934f55b329df36468daf2.png" />
                            </ComboBoxItem>
                            <ComboBoxItem Name="french" >
                                <Image Source="/Resources/Img/flags/french-c3474adb98d8835fb5a86b3988d6b963a1ac2a8327d136b11fb0fd0537b45594.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="japanese" >
                                <Image Source="/Resources/Img/flags/japanese-16a9b5bae87a5494d5a002cf7a2c2c5de5cead128a965cbf3a89eeee8292b997.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="jeanne_darc" >
                                <Image Source="/Resources/Img/flags/jeanne_darc-aeec47c19181d6af7b08a015e8a109853d7169d02494b25208d3581e38d022eb.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="malians" >
                                <Image Source="/Resources/Img/flags/malians-edb6f54659da3f9d0c5c51692fd4b0b1619850be429d67dbe9c3a9d53ab17ddd.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="mongols" >
                                <Image Source="/Resources/Img/flags/mongols-7ce0478ab2ca1f95d0d879fecaeb94119629538e951002ac6cb936433c575105.png"/>
                            </ComboBoxItem>
                           <ComboBoxItem Name="golden_horde" >
                              <Image Source="/Resources/Img/flags/golden_horde.png"/>
                           </ComboBoxItem>
                           <ComboBoxItem Name="order_of_the_dragon" >
                                <Image Source="/Resources/Img/flags/order_of_the_dragon-cad6fa9212fd59f9b52aaa83b4a6173f07734d38d37200f976bcd46827667424.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="ottomans" >
                                <Image Source="/Resources/Img/flags/ottomans-83c752dcbe46ad980f6f65dd719b060f8fa2d0707ab8e2ddb1ae5d468fc019a2.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="rus" >
                                <Image Source="/Resources/Img/flags/rus-cb31fb6f8663187f63136cb2523422a07161c792de27852bdc37f0aa1b74911b.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="zhu_xis_legacy" >
                                <Image Source="/Resources/Img/flags/zhu_xis_legacy-c4d119a5fc11f2355f41d206a8b65bea8bab2286d09523a81b7d662d1aad0762.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="knights_templar" >
                                <Image Source="/Resources/Img/flags/knights_templar-0dc0979a16240ed364b6859ec9aef4cd53f059144ee45b6fd3ea7bfaea209b16.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="lancaster" >
                                <Image Source="/Resources/Img/flags/lancaster.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="macedonian_dynasty" ToolTip="马其顿王朝">
                                <Image Source="/Resources/Img/flags/macedonian_dynasty.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="sengoku_daimyo" ToolTip="战国大名">
                                <Image Source="/Resources/Img/flags/sengoku_daimyo.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="tughlaq_dynasty" ToolTip="图格鲁克王朝">
                                <Image Source="/Resources/Img/flags/tughlaq_dynasty.png"/>
                            </ComboBoxItem>
                            <ComboBoxItem Name="jin_dynasty" ToolTip="金朝">
                                <Image Source="/Resources/Img/flags/jin_dynasty.png"/>
                            </ComboBoxItem>
                        </AduSkin:AduComboBox>
                        <Border Width="52" Height="28" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#F2F2F2" BorderBrush="#B8B8B8" BorderThickness="1" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=CivilizationSelector}" Value="-1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="?" FontSize="18" Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        </Grid>
                    </AduSkin:AduFormLable>
                    <Button Content="Reset" Click="Reset_Click" Width="50" Height="25" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ProductionStatus" Visibility="Collapsed" Margin="10,5,10,5" MaxWidth="235" TextWrapping="Wrap" FontSize="11"/>
                <AduSkin:AduExpander Header="Auto Training" IsEnabled="True" IsExpanded="True" AduAttach:PathDataAttach.PathData="{StaticResource Icon_Logo}" AduAttach:PathDataAttach.Width="14" AduAttach:PathDataAttach.Margin="4,0,10,2">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Width="253">
                            <AduSkin:MetroSwitch Margin="10" BorderCornerRadius="3" Content="TC" CornerRadius="2" Checked="Tc_Checked" Unchecked="Tc_Checked"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" UpDownOrientation="Horizontal" TextChanged="tcNumChanged" Height="19" />
                            <AduSkin:MetroSwitch Margin="10" BorderCornerRadius="3" Content="MA" ToolTip="军事学院：军队训练速度 +33%，村民时间不变" CornerRadius="2" Checked="Ma_Checked" Unchecked="Ma_Checked"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Grid Margin="3" Cursor="Hand" MouseDown="Archery_Clicked" Width="36" Height="36">
                                <Image Source="/Resources/Img/buildings/AoE4_ArcheryRange.webp"  Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Name="ArcheryRing" Width="36" Height="36" StrokeThickness="4" Stroke="#f4f2dc" StrokeDashArray="8 7" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RadiusX="6" RadiusY="6" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Q" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="a_q_Changed" Height="19" Width="40" />
                            <TextBlock Text="W" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="a_w_Changed" Height="19" Width="40" />
                            <StackPanel x:Name="ArcheryESlot" Orientation="Horizontal">
                                <TextBlock Text="E" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="ArcheryECount" Maximum="10" Minimum="0" Value="0" TextChanged="a_e_Changed" Height="19" Width="40" />
                            </StackPanel>
                            <StackPanel x:Name="ArcheryRSlot" Orientation="Horizontal">
                                <TextBlock Text="R" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="ArcheryRCount" Maximum="10" Minimum="0" Value="0" TextChanged="a_r_Changed" Height="19" Width="40" />
                            </StackPanel>

                        </WrapPanel>
                        <WrapPanel>
                            <Grid Margin="3" Cursor="Hand" MouseDown="Stable_Clicked" Width="36" Height="36">
                                <Image Source="Resources/Img/buildings/AoE4_Stable.webp"  Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Name="StableRing" Width="36" Height="36" StrokeThickness="4" Stroke="#f4f2dc" StrokeDashArray="8 7" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RadiusX="6" RadiusY="6" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Q" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="s_q_Changed" Height="19" Width="40" />
                            <TextBlock Text="W" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="s_w_Changed" Height="19" Width="40" />
                            <StackPanel x:Name="StableESlot" Orientation="Horizontal">
                                <TextBlock Text="E" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="StableECount" Maximum="10" Minimum="0" Value="0" TextChanged="s_e_Changed" Height="19" Width="40" />
                            </StackPanel>
                            <StackPanel x:Name="StableRSlot" Orientation="Horizontal">
                                <TextBlock Text="R" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="StableRCount" Maximum="10" Minimum="0" Value="0" TextChanged="s_r_Changed" Height="19" Width="40" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <Grid Margin="3" Cursor="Hand" MouseDown="Barracks_Clicked" Width="36" Height="36">
                                <Image Source="Resources/Img/buildings/AoE4_Barracks.webp"  Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Name="BarracksRing" Width="36" Height="36" StrokeThickness="4" Stroke="#f4f2dc" StrokeDashArray="8 7" StrokeDashCap="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" RadiusX="6" RadiusY="6" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Q" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="b_q_Changed" Height="19" Width="40" />
                            <TextBlock Text="W" Height="19" Margin="1" FontSize="16"/>
                            <AduSkin:AduIntegerUpDown Maximum="10" Minimum="0" Value="0" TextChanged="b_w_Changed" Height="19" Width="40" />
                            <StackPanel x:Name="BarracksESlot" Orientation="Horizontal">
                                <TextBlock Text="E" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="BarracksECount" Maximum="10" Minimum="0" Value="0" TextChanged="b_e_Changed" Height="19" Width="40" />
                            </StackPanel>
                            <StackPanel x:Name="BarracksRSlot" Orientation="Horizontal">
                                <TextBlock Text="R" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="BarracksRCount" Maximum="10" Minimum="0" Value="0" TextChanged="b_r_Changed" Height="19" Width="40" />
                            </StackPanel>
                            <StackPanel x:Name="BarracksTSlot" Orientation="Horizontal" ToolTip="条顿骑士">
                                <TextBlock Text="T" Height="19" Margin="1" FontSize="16"/>
                                <AduSkin:AduIntegerUpDown x:Name="BarracksTCount" Maximum="10" Minimum="0" Value="0" TextChanged="b_t_Changed" Height="19" Width="40" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </AduSkin:AduExpander>
                <StackPanel Margin="10,6,10,10" ToolTip="持续生产的保守估算；按基础采集效率计算，仅计龙之骑士团和图格鲁克的固定加成。">
                    <TextBlock Text="采集人数估算" FontSize="11" Margin="0,0,0,4"/>
                    <UniformGrid Columns="3">
                        <StackPanel><TextBlock Text="食物" FontSize="11"/><TextBlock x:Name="FoodFarmers" Text="0.00" FontSize="14"/></StackPanel>
                        <StackPanel><TextBlock Text="木材" FontSize="11"/><TextBlock x:Name="WoodFarmers" Text="0.00" FontSize="14"/></StackPanel>
                        <StackPanel><TextBlock Text="黄金" FontSize="11"/><TextBlock x:Name="GoldFarmers" Text="0.00" FontSize="14"/></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
